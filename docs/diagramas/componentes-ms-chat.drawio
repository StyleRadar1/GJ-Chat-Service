arget="stores"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="Feign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#48119A;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chat" target="donations"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#48119A;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chat" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="Pub/Sub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#48119A;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="chat" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="venta / mensaje" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#48119A;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="chat" target="rabbit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#48119A;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rabbit" target="notify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;Web / móvil&lt;br&gt;REST HTTPS · STOMP WSS" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#F2E8D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="250" height="150" as="geometry" /></mxCell><mxCell id="auth" value="&lt;b&gt;ms-auth&lt;/b&gt;&lt;br&gt;Emite JWT HS256&lt;br&gt;sub numérico · roles" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#FFF2D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="165" width="250" height="145" as="geometry" /></mxCell><mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;Enruta REST y WebSocket&lt;br&gt;Reenvía JWT" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#E4DBF0;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="440" width="250" height="150" as="geometry" /></mxCell><mxCell id="chat" value="&lt;b&gt;ms-chat · :8320&lt;/b&gt;&lt;br&gt;REST + WebSocket/STOMP (/ws)&lt;br&gt;JWT local + autorización por conversación&lt;br&gt;C2C · almacén aliado · donación&lt;br&gt;Historial paginado · mensaje inicial&lt;br&gt;Feign a servicios propietarios&lt;br&gt;RabbitMQ · Redis Pub/Sub opcional" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#E4DBF0;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="750" y="325" width="440" height="390" as="geometry" /></mxCell><mxCell id="second" value="&lt;b&gt;Servicio de segunda mano&lt;/b&gt;&lt;br&gt;Feign: publicación, vendedor y disponibilidad&lt;br&gt;Rabbit: venta → cierre de conversaciones" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#F2E8D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1370" y="145" width="420" height="145" as="geometry" /></mxCell><mxCell id="stores" value="&lt;b&gt;ms-tiendas&lt;/b&gt;&lt;br&gt;Feign: almacén por NIT y administrador&lt;br&gt;Admin solo accede al NIT propio" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#F2E8D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1370" y="355" width="420" height="145" as="geometry" /></mxCell><mxCell id="donations" value="&lt;b&gt;ms-segunda-vida-donaciones&lt;/b&gt;&lt;br&gt;Feign: solicitud, donante, fundación y estado&lt;br&gt;El cierre por cambio posterior está pendiente" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#F2E8D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1370" y="565" width="420" height="145" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;chat_db · PostgreSQL&lt;/b&gt;&lt;br&gt;Conversaciones · mensajes&lt;br&gt;processed_events para eventos entrantes" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#E8F0FA;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="785" y="850" width="370" height="150" as="geometry" /></mxCell><mxCell id="redis" value="&lt;b&gt;Redis · opcional&lt;/b&gt;&lt;br&gt;Relay STOMP entre instancias&lt;br&gt;No es almacenamiento del historial" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#E8F0FA;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="300" height="150" as="geometry" /></mxCell><mxCell id="rabbit" value="&lt;b&gt;RabbitMQ · AMQPS&lt;/b&gt;&lt;br&gt;Consume venta · publica mensaje enviado&lt;br&gt;Confirms/returns detectan fallos&lt;br&gt;Entrega final se acuerda con ms-notificaciones" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#FFF2D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1370" y="815" width="420" height="150" as="geometry" /></mxCell><mxCell id="notify" value="&lt;b&gt;ms-notificaciones&lt;/b&gt;&lt;br&gt;Consume eventos de mensajes; validar resolución de almacén" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#48119A;fillColor=#F2E8D8;fontColor=#272332;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1370" y="1030" width="420" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>